# Puerto del servidor HTTP local.
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Genere un valor unico y aleatorio de al menos 32 caracteres antes de produccion.
# Ejemplo (PowerShell): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-production

# Ruta relativa al proyecto o ruta absoluta para SQLite.
DATABASE_PATH=data/byteguard.db

# Solo para crear el primer administrador con: npm run seed:admin
# ADMIN_EMAIL=admin@ejemplo.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administración ByteGuard
